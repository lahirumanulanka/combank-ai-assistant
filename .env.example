APP_NAME=Commercial Bank Knowledge Assistant
BRAND_NAME=Commercial Bank
LOG_LEVEL=INFO
# true = one JSON object per line (for Docker / log tools), false = pretty colours for dev
LOG_JSON=false

# generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_TTL_S=7200
USERS_FILE=data/users.yaml

# token bucket per user: [capacity, refill per second]
RATE_LIMIT_VIEWER=[10, 0.2]
RATE_LIMIT_ANALYST=[20, 0.5]
RATE_LIMIT_ADMIN=[30, 1.0]

DOCS_DIR=data/docs
BM25_PARAMS_PATH=data/bm25_params.json

# OpenAI is used only to turn text into embeddings (numbers)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Pinecone vector database (free serverless tier works)
PINECONE_API_KEY=
PINECONE_INDEX=combank-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# hybrid search: 1.0 = only meaning search, 0.0 = only keyword (BM25) search
HYBRID_ALPHA=0.7
RETRIEVAL_TOP_K=8
# chunks scoring below this are treated as "not found"
RETRIEVAL_MIN_SCORE=0.3

# LLM: "provider:model". Use anthropic:... with ANTHROPIC_API_KEY, or openai:... with OPENAI_API_KEY
ANTHROPIC_API_KEY=
LLM_STRONG=anthropic:claude-sonnet-5-5
LLM_CHEAP=anthropic:claude-haiku-5-5
LLM_TIMEOUT_S=40

# conversation memory (chat history per thread) is saved here
CHECKPOINT_DB=data/checkpoints.db
